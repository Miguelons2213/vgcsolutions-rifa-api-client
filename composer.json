{
    "name": "vgcsolutions/rifa-api-client",
    "description": "Cliente Laravel para consumir la API segura de rifas.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Rifa\\ApiClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rifa\\ApiClient\\RifaApiClientServiceProvider"
            ],
            "aliases": {
                "RifaApi": "Rifa\\ApiClient\\Facades\\RifaApi"
            }
        }
    }

}
